# ============================================
# OPDM FastAPI 服务 — 环境变量配置模板
# ============================================
# 说明：
# 1. 复制此文件为 .env 并修改配置值
# 2. 生产环境务必修改所有 secret 相关配置
# 3. 带有 [必填] 标记的配置项必须设置
# ============================================

# ============================================
# 数据库配置
# ============================================
# [必填] 数据库连接地址
# 开发环境：使用 SQLite（默认），数据存储在 ./data/ 目录
# 生产环境：使用 SQL Server，格式如下：
#   mssql+aiodbc://用户名:密码@主机:端口/数据库名?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# 注意：生产环境需安装 aioodbc 依赖: pip install -e ".[prod]"
DB_CONNECTION_STRING=sqlite+aiosqlite:///./data/app.db

# ============================================
# 外部服务配置
# ============================================
# [必填] Auth Server 地址（用户认证、员工/部门查询、数据权限校验）
AUTH_SERVICE_URL=http://localhost:8001

# ============================================
# JWT 配置（由共享包 opdm_auth_client 读取）
# ============================================
# [必填] JWT 密钥 - 必须与 Auth Server 保持一致！
# 生成方式：python -c "import uuid; print(uuid.uuid4().hex)"
JWT_SECRET_KEY=your-secret-key-here

# JWT 签名算法（默认 HS256，需与 Auth Server 保持一致）
JWT_ALGORITHM=HS256

# ============================================
# 服务间认证配置
# ============================================
# [必填] 服务间调用 Token
# 用于调用其他内部服务的接口，需与目标服务的 SERVICE_TOKEN 一致
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=your-service-token-here

# ============================================
# 应用配置
# ============================================
# 服务名称（用于日志标识和健康检查响应）
SERVICE_NAME=my-service

# 服务监听端口
SERVICE_PORT=8000

# 调试模式：true | false（生产环境必须设为 false）
DEBUG=false

# 运行环境：development | production
# development: 启动时自动创建数据库表
# production: 需要通过 alembic 迁移管理数据库
APP_ENV=development

# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
