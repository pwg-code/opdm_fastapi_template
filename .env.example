# ============================================
# OPDM FastAPI 服务 — 环境变量配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env：  cp .env.example .env
# 2. 将所有 <...> 占位符替换为实际值；不得将真实 .env 提交到仓库。
# 3. 标 [必填] 的项必须设置；标 [可选] 的项未配置时使用模板默认值。
# 4. Docker bridge 模式下，localhost 指容器自身。
#    若 Redis / Auth 等指向宿主机服务，需将 localhost 改为
#    172.17.0.1（Docker 默认 bridge 网关即宿主机）。
# ============================================

# ============================================
# 服务基础
# ============================================
# [必填] 服务名（用于日志、健康检查、文档标题）
SERVICE_NAME=<SERVICE_NAME>
# [必填] 服务监听端口（容器外通过 nginx 反向代理转发）
SERVICE_PORT=<SERVICE_PORT>
# [必填] gunicorn worker 数（生产推荐 = CPU 核心数 * 2 + 1）
SERVICE_WORKERS=<SERVICE_WORKERS>

# 运行环境：development | production
# development：启动时自动建表（仅 SQLite 调试用）
# production：必须使用 alembic 管理数据库结构
APP_ENV=production
DEBUG=false

# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ============================================
# 数据库
# ============================================
# [必填] 主库连接地址
# 开发（SQLite）：  sqlite+aiosqlite:///./data/app.db
# 生产（SQL Server）：
#   mssql+aiodbc://<user>:<password>@<host>:<port>/<db>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# 生产需安装 aioodbc 依赖：pip install -e ".[prod]"
DB_CONNECTION_STRING=<DB_CONNECTION_STRING>

# ============================================
# Redis（可选）
# ============================================
# [可选] Redis 连接地址。用于：opdm_lib.auth 权限缓存、业务级缓存。
# 留空则 auth 与业务缓存均降级为 no-op。
# 必须与 auth 服务指向同一 Redis 实例与数据库编号。
# REDIS_URL=redis://<host>:6379/1

# ============================================
# 认证服务
# ============================================
# [必填] Auth Server 地址（用户认证、员工/部门查询、数据权限校验）
AUTH_SERVICE_URL=http://<AUTH_SERVICE_HOST>:8001

# [必填] 服务间调用 Token，与目标服务的 SERVICE_TOKEN 一致
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=<SERVICE_TOKEN>

# [必填] JWT 密钥 - 必须与 Auth Server 保持一致！
# 生成：python -c "import uuid; print(uuid.uuid4().hex)"
JWT_SECRET_KEY=<JWT_SECRET_KEY>

# JWT 签名算法（默认 HS256，需与 Auth Server 保持一致）
JWT_ALGORITHM=HS256